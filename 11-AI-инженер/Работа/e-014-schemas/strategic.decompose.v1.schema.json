{
  "type": "json_schema",
  "json_schema": {
    "name": "strategic_decompose",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "milestones": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "position": { "type": "integer", "minimum": 1, "maximum": 4 },
              "title": { "type": "string", "maxLength": 100 },
              "week": { "type": "integer", "minimum": 1, "maximum": 6 },
              "success_criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "type": "string",
                      "enum": ["tasks_done", "contacts_added", "dialogs_started", "leads_new"]
                    },
                    "min": { "type": "integer", "minimum": 1, "maximum": 100 },
                    "task_type": { "type": ["string", "null"], "maxLength": 64 },
                    "source": { "type": ["string", "null"], "maxLength": 32 }
                  },
                  "required": ["metric", "min", "task_type", "source"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["position", "title", "week", "success_criteria"],
            "additionalProperties": false
          }
        },
        "plan_rationale": { "type": "string", "maxLength": 400 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string", "maxLength": 64 },
              "type": {
                "type": "string",
                "enum": [
                  "strategy.base_collect",
                  "strategy.base_reactivate",
                  "strategy.follow_up",
                  "strategy.trial_convert",
                  "strategy.referral_ask",
                  "strategy.offer_setup",
                  "strategy.link_share",
                  "strategy.social_profile",
                  "strategy.listing_setup",
                  "strategy.content_post",
                  "strategy.content_short",
                  "strategy.community_engage",
                  "strategy.partner_outreach",
                  "strategy.review_collect"
                ]
              },
              "title": { "type": "string", "maxLength": 100 },
              "frequency": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "enum": ["once", "daily", "times_per_week"] },
                  "times_per_week": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 }
                },
                "required": ["kind", "times_per_week"],
                "additionalProperties": false
              },
              "minutes": { "type": "integer", "minimum": 5, "maximum": 60 },
              "milestone_position": { "type": ["integer", "null"], "minimum": 1, "maximum": 4 },
              "hint": { "type": "string", "maxLength": 200 }
            },
            "required": ["key", "type", "title", "frequency", "minutes", "milestone_position", "hint"],
            "additionalProperties": false
          }
        }
      },
      "required": ["milestones", "plan_rationale", "items"],
      "additionalProperties": false
    }
  }
}
