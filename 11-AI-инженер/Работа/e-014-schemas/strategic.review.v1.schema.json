{
  "type": "json_schema",
  "json_schema": {
    "name": "strategic_review",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["on_track", "behind", "failed", "too_early"]
        },
        "recommendation": {
          "type": "string",
          "enum": ["continue", "adjust", "change_strategy"]
        },
        "what_works": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 200 }
        },
        "what_does_not": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 200 }
        },
        "suggestions": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 200 }
        },
        "explanation": { "type": "string", "maxLength": 500 }
      },
      "required": [
        "status",
        "recommendation",
        "what_works",
        "what_does_not",
        "suggestions",
        "explanation"
      ],
      "additionalProperties": false
    }
  }
}
