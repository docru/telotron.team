        "about": { "type": ["string", "null"], "maxLength": 600 },
        "unclear": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "specialization",
              "services",
              "goal_clients_per_month",
              "old_base_size",
              "channels",
              "hours_per_week",
              "urgency",
              "offer",
              "offer_note",
              "about"
            ]
          }
        }
      },
      "required": [
