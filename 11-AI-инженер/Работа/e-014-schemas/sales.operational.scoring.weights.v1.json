    "window_days": 14,
    "per_reject": { "crm.remind_stale": -5, "strategy.*": -10 },
    "cap": { "crm.remind_stale": -15, "strategy.*": -20 },
    "not_applied_to": ["crm.reply_new_contact", "crm.next_action"]
  },
  "skill_new": {
    "value": -10,
    "when": "skill level 0 по навыку типа И среди кандидатов дня есть задача уровня 0 или 1",
    "applies_to": ["strategy.*"]
  },
  "floor": 0,
  "thresholds": {
    "drop_below_if_enough": 20,
    "drop_below_always": 10,
    "comment": "<10 — убрать, если после этого остаётся хоть один кандидат; <20 — убрать, если после этого остаётся не меньше items_max(intensity) кандидатов"
  },
  "candidates_max": 15,
